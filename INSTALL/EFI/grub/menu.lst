default 2
color normal=0xFFFFFF highlight=0x60825c00aaffaa helptext=0xaaffaa heading=0x66ff00
graphicsmode -1 1024
font --font-high=24 /EFI/grub/font24
font /EFI/grub/unifont.hex
splashimage /efi/grub/background.jpg
setmenu --ver-off
setmenu --lang=en
setmenu --auto-num-on
setmenu --triangle-off
setmenu --highlight-full
setmenu --box x=10 w=65 y=6 h=19 l=0
setmenu --help=6=0=28
setmenu --help-off
setmenu --string=m=2=0x00000000FFFFFF="---=== Grub4Dos - 0.4.6a - for EFI - 07-05-2021 ===---"
#setmenu --timeout=2=1=0x00000000FFFFFF
#setmenu --hotkey -A [F4] commandline
setmenu --string=13=4=0xFFFFFF="date&time -=- Bugün dd-MM-yyyy ---===--- Saat HH:mm:ss -=-"
#write --bytes=2 0x8274 0x2d01
title Choose and press ENTER/Seçin ve ENTER tuşuna basın
  pause --wait=0
  title
root
title Windows 7/8.1/10 HDD Boot \n Locate and boot up any system with Windows 7, 8.1, or 10 installed on the HDD....
  find --set-root --ignore-floppies --ignore-cd /EFI/Microsoft/Boot/bootmgfw.efi
  chainloader /EFI/Microsoft/Boot/bootmgfw.efi
  savedefault --wait=2
title
root
title Ventoy Boot \n Ventoy EFI Multiboot loader
  chainloader /EFI/boot/bootx64.efi
boot
else
chainloader /EFI/boot/bootia32.efi
boot
  title
root
title Grub2 File Manager \n GrubFM Multiboot loader
  chainloader /EFI/boot/grubfmx64.efi
boot
else
chainloader /EFI/boot/grubfmia32.efi
boot 
title
root
title Restart the system \n Restart Pc..
reboot
title
root
title Shutdown the computer \n Pc Halt..
halt
